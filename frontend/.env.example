# ChronoVault Frontend Environment Configuration

# 1. Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anonymous Public Key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. ChronoVault Node.js/Express Backend URL
VITE_API_URL=http://localhost:5000/api
