# ChronoVault Backend Server Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Keep this secret! Never share or commit to Git)
# This allows the server to verify timestamps, manage temporal locks, and sign file URLs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anonymous Public Key (optional on backend, used for token verification)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
